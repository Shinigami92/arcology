filters = ["Armature/Skeleton3D:RightIndexMetacarpal", "Armature/Skeleton3D:RightIndexProximal", "Armature/Skeleton3D:RightIndexIntermediate", "Armature/Skeleton3D:RightIndexDistal", "Armature/Skeleton3D:RightIndexTip"]

[sub_resource type="AnimationNodeBlend2" id="AnimationNodeBlend2_grip"]
filter_enabled = true
filters = ["Armature/Skeleton3D:RightThumbMetacarpal", "Armature/Skeleton3D:RightThumbProximal", "Armature/Skeleton3D:RightThumbDistal", "Armature/Skeleton3D:RightThumbTip", "Armature/Skeleton3D:RightMiddleMetacarpal", "Armature/Skeleton3D:RightMiddleProximal", "Armature/Skeleton3D:RightMiddleIntermediate", "Armature/Skeleton3D:RightMiddleDistal", "Armature/Skeleton3D:RightMiddleTip", "Armature/Skeleton3D:RightRingMetacarpal", "Armature/Skeleton3D:RightRingProximal", "Armature/Skeleton3D:RightRingIntermediate", "Armature/Skeleton3D:RightRingDistal", "Armature/Skeleton3D:RightRingTip", "Armature/Skeleton3D:RightLittleMetacarpal", "Armature/Skeleton3D:RightLittleProximal", "Armature/Skeleton3D:RightLittleIntermediate", "Armature/Skeleton3D:RightLittleDistal", "Armature/Skeleton3D:RightLittleTip"]

[sub_resource type="AnimationNodeBlendTree" id="AnimationNodeBlendTree_hand"]
nodes/OpenHand/node = SubResource("AnimationNodeAnimation_open")
