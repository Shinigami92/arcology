[gd_scene format=3]

[ext_resource type="Script" path="res://core/player/hands/avatar_hand.gd" id="1_hand"]
[ext_resource type="PackedScene" path="res://assets/characters/silena_vesper/silena_vesper_hand_right.glb" id="2_model"]

