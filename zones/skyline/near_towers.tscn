[node name="NearTowers" type="Node3D"]
metadata/_doc = "Near ring of the city, generated by tools/props/city.py from tools/city/near_towers.json: one node per tower at its base center on the street (sunk below it for placements), turned by its yaw (local +Z faces our building). The first ten are the hero towers in front of the apartment, the rest copies of them around the other sides (D-061). FarTowers repeats them further out and keeps the cells around metadata/footprint (width, depth) clear; OutsideView draws each while a window onto its side is in view."

