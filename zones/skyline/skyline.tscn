[node name="Skyline" type="Node3D"]
metadata/_doc = "World backdrop outside every zone: sky, environment, moonlight, near towers (tools/props/city.py), the far city repeating them (FarTowers), flying traffic (Traffic). M2 world_state drives the environment; see docs/decisions.md D-008 for coordinates."

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_night")

[node name="Moon" type="DirectionalLight3D" parent="."]
rotation_degrees = Vector3(-35, 150, 0)
light_color = Color(0.6, 0.7, 1, 1)
light_energy = 0.15
shadow_enabled = false
sky_mode = 1

[node name="NearTowers" parent="." instance=ExtResource("3_near")]

[node name="FarTowers" type="Node3D" parent="." node_paths=PackedStringArray("near_towers", "traffic")]
script = ExtResource("1_far")
near_towers = NodePath("../NearTowers")
traffic = NodePath("../Traffic")

[node name="Traffic" type="Node3D" parent="." node_paths=PackedStringArray("world_environment")]
script = ExtResource("4_traffic")
vehicles = Array[PackedScene]([ExtResource("v_aircar_sedan"), ExtResource("v_aircar_taxi"), ExtResource("v_hover_van"), ExtResource("v_patrol_cruiser"), ExtResource("v_sky_bus")])
weights = PackedFloat32Array(35, 25, 18, 8, 14)
albedo = ExtResource("t_albedo")
orm = ExtResource("t_orm")
normal = ExtResource("t_normal")
emission = ExtResource("t_emission")
emission_energy = 6.0
world_environment = NodePath("../WorldEnvironment")

[node name="StreetGlow" type="MeshInstance3D" parent="."]
position = Vector3(0, -180, 0)
cast_shadow = 0
mesh = SubResource("PlaneMesh_street")
surface_material_override/0 = SubResource("StandardMaterial3D_street")

[node name="OutsideView" type="Node" parent="." node_paths=PackedStringArray("targets")]
script = ExtResource("5_outside")
targets = [NodePath("../NearTowers"), NodePath("../FarTowers"), NodePath("../Traffic"), NodePath("../StreetGlow")]
metadata/_doc = "Hides the city while no window is on screen (window notifiers in the outside_view group, D-048)."
