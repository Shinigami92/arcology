[node name="Skyline" type="Node3D"]
metadata/_doc = "World backdrop outside every zone: sky, environment, sky light (sun by day, moon by night), near towers (tools/props/city.py), the far city repeating them (FarTowers), flying traffic (Traffic), all around our building, each side drawn by OutsideView only while a window onto it is in view (D-061). The environment, sky and moon as authored are the night; DayNight changes them from the WorldState clock (D-051). Coordinates: D-008."

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_night")

[node name="SkyLight" type="DirectionalLight3D" parent="."]
rotation_degrees = Vector3(-35, 150, 0)
light_color = Color(0.6, 0.7, 1, 1)
light_energy = 0.15
shadow_enabled = false
shadow_blur = 1.5
directional_shadow_mode = 0
directional_shadow_max_distance = 24.0

[node name="NearTowers" parent="." instance=ExtResource("3_near")]

[node name="FarTowers" type="Node3D" parent="." node_paths=PackedStringArray("near_towers", "traffic")]
script = ExtResource("1_far")
near_towers = NodePath("../NearTowers")
traffic = NodePath("../Traffic")

[node name="Traffic" type="Node3D" parent="." node_paths=PackedStringArray("world_environment")]
script = ExtResource("4_traffic")
vehicles = Array[PackedScene]([ExtResource("v_aircar_sedan"), ExtResource("v_aircar_taxi"), ExtResource("v_hover_van"), ExtResource("v_patrol_cruiser"), ExtResource("v_sky_bus")])
weights = PackedFloat32Array(35, 25, 18, 8, 14)
albedo = ExtResource("t_albedo")
orm = ExtResource("t_orm")
normal = ExtResource("t_normal")
emission = ExtResource("t_emission")
emission_energy = 6.0
world_environment = NodePath("../WorldEnvironment")

[node name="OutsideView" type="Node" parent="." node_paths=PackedStringArray("targets")]
script = ExtResource("5_outside")
targets = [NodePath("../NearTowers"), NodePath("../FarTowers"), NodePath("../Traffic")]
metadata/_doc = "Draws each side of the city only while a window facing it is on screen (window notifiers in the outside_view group with metadata/outside_facing; parts: the targets' children, D-048, D-061)."

[node name="DayNight" type="Node" parent="." node_paths=PackedStringArray("world_environment", "sky_light", "outside", "traffic", "far_towers")]
script = ExtResource("6_day_night")
world_environment = NodePath("../WorldEnvironment")
sky_light = NodePath("../SkyLight")
outside = [NodePath("../NearTowers"), NodePath("../FarTowers"), NodePath("../Traffic")]
lit_windows = Array[BaseMaterial3D]([ExtResource("m_brutal_windows"), ExtResource("m_spire_glass")])
signs = Array[BaseMaterial3D]([ExtResource("m_brutal_neon"), ExtResource("m_spire_ads"), ExtResource("m_spire_lights")])
traffic = NodePath("../Traffic")
far_towers = NodePath("../FarTowers")
metadata/_doc = "Lights sky, city and windows from the WorldState clock and weather (D-051); night = this scene as authored."
