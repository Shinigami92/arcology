[node name="Door" type="Node3D" unique_id=32924855]
metadata/_doc = "Hinged door, 0.88 x 2.08 m leaf. Origin = bottom of the hinge axis; the leaf extends along +X and opens toward -Z (0..100 degrees). Handle at 1.1 m (seated reach). Grab either handle to swing it; let go while moving and it swings on (the latch catches it within 3 degrees of closed); the leaf stops instead of passing through the player."

